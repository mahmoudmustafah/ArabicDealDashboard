{
  "name": "deal-radar-service",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Backend for the Deal Radar dashboard: 10-minute store scans, price history, evidence, Telegram publishing.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "scan-once": "node --env-file-if-exists=.env --import tsx src/cli.ts scan-once",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "telegram-setup": "node --env-file-if-exists=.env --import tsx src/cli.ts telegram-setup",
    "backfill": "node --env-file-if-exists=.env --import tsx src/cli.ts backfill"
  },
  "dependencies": {
    "node-html-parser": "^6.1.13",
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
